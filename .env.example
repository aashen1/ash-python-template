# =============================================================================
# Environment configuration template
# =============================================================================
# Copy this file to `.env` and fill in real values for your local environment.
# Never commit `.env` to version control (it is already listed in .gitignore).
# =============================================================================

# Application
APP_NAME=change-to-your-name
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
